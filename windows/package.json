{
  "name": "@v18/windows",
  "productName": "V18",
  "version": "0.2.0",
  "description": "V18 for Windows: prove you're 18+ without saying who you are",
  "author": "V18",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:js": "node scripts/build.mjs",
    "build": "npm run build:native && npm run build:js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "start:test-key": "npm run build && electron . --v18-test-software-key",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:smoke": "node --import tsx --test --test-reporter=spec --test-concurrency=1 test/smoke/*.smoke.ts",
    "dist:release": "npm run build:native && node scripts/build.mjs --release && electron-builder --win nsis --x64 --publish never",
    "icons": "electron scripts/make-icons.cjs",
    "hello:check": "node scripts/hello-check.mjs",
    "test:e2e": "node --import tsx --test --test-reporter=spec --test-concurrency=1 test/e2e/*.e2e.ts",
    "test:installer": "node --import tsx --test --test-reporter=spec --test-concurrency=1 test/installer/*.test.ts",
    "test:live-connector": "node --import tsx --test --test-reporter=spec --test-concurrency=1 test/live/connector.live.ts"
  },
  "devDependencies": {
    "@anon-aadhaar/core": "^2.4.3",
    "@cloudflare/blindrsa-ts": "^0.4.6",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.65.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "snarkjs": "^0.7.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
